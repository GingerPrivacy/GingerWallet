<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="using:WalletWasabi.Lang"
             xmlns:vm="using:WalletWasabi.Fluent.TransactionViewer.ViewModels"
             xmlns:controls="using:WalletWasabi.Fluent.TransactionViewer.Controls"
             x:Class="WalletWasabi.Fluent.TransactionViewer.Views.TransactionFlowView"
             x:DataType="vm:TransactionViewerViewModel" x:CompileBindings="True">
  <UserControl.Styles>
    <Style Selector="ScrollViewer">
      <Setter Property="AllowAutoHide" Value="False" />
    </Style>
    <Style Selector="ScrollViewer ScrollBar">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="AllowAutoHide" Value="False" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.coin">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="14 10" />
      <Setter Property="Background" Value="{DynamicResource TileRegionColor}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Button.coin.selected">
      <Setter Property="BorderBrush" Value="SteelBlue" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.coin.selected.own">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    </Style>
    <Style Selector="TextBlock.ownership">
      <Setter Property="Foreground" Value="SteelBlue" />
    </Style>
    <Style Selector="Button.own TextBlock.ownership">
      <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <DataTemplate x:Key="Node" x:DataType="vm:TransactionViewerNode">
      <Button Classes="coin" Classes.own="{Binding IsOwn}" Classes.selected="{Binding IsSelected}"
              Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding Title}">
        <StackPanel Spacing="3">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" Margin="0 0 10 0" Opacity="0.65" />
            <TextBlock Text="{Binding Title}" Classes="ownership" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
          </DockPanel>
          <TextBlock Text="{Binding ShortAddress}" FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Amount}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Amount}" />
          <TextBlock Text="{Binding Fiat^}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Fiat^}" />
        </StackPanel>
      </Button>
    </DataTemplate>
  </UserControl.Resources>
  <Grid ClipToBounds="True">
    <ListBox Name="CoinRows" ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0" Padding="0"
             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:TransactionViewerRow">
          <Grid ColumnDefinitions="*,240,*" Height="144">
            <ContentControl Content="{Binding Input}" IsVisible="{Binding !!Input}" ContentTemplate="{StaticResource Node}" Margin="0 10 12 10" />
            <ContentControl Grid.Column="2" Content="{Binding Output}" IsVisible="{Binding !!Output}" ContentTemplate="{StaticResource Node}" Margin="12 10" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Grid Name="FlowOverlay" IsHitTestVisible="False">
      <controls:TransactionFlowLines Name="FlowLines" Rows="{Binding Rows}" SelectedNode="{Binding SelectedNode}"
                                     OwnBrush="{DynamicResource SystemAccentColor}" />
      <Border Width="128" Height="84" Margin="0 0 0 70" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource TileRegionColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="7"
              IsHitTestVisible="False">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
          <TextBlock Text="{x:Static lang:Resources.Transaction}" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding VirtualSize}" Opacity="0.65" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
      <Border Width="176" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 210 0 0" Padding="10"
              Background="{DynamicResource TileRegionColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="7"
              IsHitTestVisible="False">
        <StackPanel Spacing="4">
          <TextBlock Text="{x:Static lang:Resources.TransactionFee}" FontSize="12" Opacity="0.65" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding FeeText}" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding FeeFiat^}" FontSize="12" Opacity="0.65" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
